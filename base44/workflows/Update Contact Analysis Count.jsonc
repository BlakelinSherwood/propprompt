{
  "name": "Update Contact Analysis Count",
  "description": "Automatically increment contact analyses_count and update last_analysis_date when an analysis linked to a contact is created",
  "trigger": {
    "condition": "${ (.trigger.data.contact_id != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Analysis"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "update_contact_analysis_count",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateContactAnalysisCount",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateContactAnalysisCount"
  }
}